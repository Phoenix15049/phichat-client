# Copy to .env.local (ignored by git) and adjust.

# Backend used by the Vite dev proxy (npm run dev). Defaults to https://localhost:7146.
VITE_DEV_PROXY_TARGET=https://localhost:7146

# Origin of the PhiChat API when it is NOT served from the same origin as the app.
# Leave unset to use same-origin requests (dev proxy or reverse proxy in production).
# Cross-site hosting also needs the backend's Auth:RefreshCookie:SameSite set to "None".
# VITE_SERVER_ORIGIN=https://api.example.com
